{
	"name": "all_incremental_ingestion",
	"properties": {
		"activities": [
			{
				"name": "getAllTableProperties",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "dsTablesProperties",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "getAllTableProperties",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('getAllTableProperties').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "fromSQLToAzure",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "incremental_ingestion",
									"type": "PipelineReference"
								},
								"waitOnCompletion": false,
								"parameters": {
									"schema": "dbo",
									"table": {
										"value": "@item().tableName",
										"type": "Expression"
									},
									"cdc_col": {
										"value": "@item().cdcCol",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}